{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://earnclout.fun/api/:path*" },
    { "source": "/meta/:path*", "destination": "https://earnclout.fun/meta/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*\\.(js|css|png|jpg|jpeg|ico|svg|webp))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
